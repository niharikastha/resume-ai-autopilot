# ---------------------------------------------------------------------------
# Copy to .env and fill. Nothing here has a usable default in production.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Postgres -------------------------------------------------------------
# Ports are shifted off the defaults (5433 / 6380) so this stack can run
# alongside another project's postgres/redis without a collision.
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=autopilot
POSTGRES_DB=autopilot
POSTGRES_PORT=5433
DATABASE_URL=postgresql://autopilot:autopilot@localhost:5433/autopilot?schema=public

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6380
REDIS_HOST=localhost

# --- API ------------------------------------------------------------------
PORT=3100

# Where the browser reaches the web app. Used to build the links in outbound
# email, which cannot be relative. Never taken from a request header - a
# password reset link built from an attacker-supplied Host is a way to have this
# server mail the attacker's URL to the victim.
APP_URL=http://localhost:3200

# NEXT_PUBLIC_API_URL is NOT here. The frontend reads its own env files, not this
# one: the committed default lives in frontend/.env and a deployment overrides it
# in frontend/.env.local, which is gitignored. See DEPLOY.md.

# --- Public deployment ----------------------------------------------------
# All three are only needed when this API is reached from a browser that is not
# on this machine. Leave them at the defaults for local dev and for the SSH
# tunnel setup. See DEPLOY.md.

# Extra browser origins allowed to call the API with credentials, comma
# separated, exact (scheme + host + port). APP_URL is always allowed, so this is
# for the second name a deployment answers on - a Vercel project domain
# alongside a custom one, say. Empty means "only APP_URL".
CORS_EXTRA_ORIGINS=

# SameSite on the session cookies. 'lax' is correct whenever the web app and the
# API are the same site - different ports and different subdomains both count, so
# dev and a same-domain deploy are fine. Use 'none' ONLY when the front end is
# genuinely cross-site (a *.vercel.app front end calling your own API domain);
# it is weaker, because the cookie then travels on cross-site requests.
COOKIE_SAMESITE=lax

# How many reverse proxies sit in front of the API. 0 when nothing does, 1
# behind Caddy or nginx on the same host. It decides what req.ip is, and the auth
# rate limits are keyed on req.ip - so 0 behind a proxy means every caller shares
# the proxy's address and one failed login locks out everyone.
TRUST_PROXY=0

# --- Outbound email -------------------------------------------------------
# Required for the "forgot password" flow. Leave blank and that endpoint
# returns 503 saying exactly which of these is missing - it does not silently
# pretend to have sent a message.
#
# Gmail needs an App Password, not your account password (and 2FA enabled).
# SMTP_SECURE=true is implicit TLS on port 465; leave it false for 587, which
# upgrades via STARTTLS automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER. Many providers reject a From that is not the
# authenticated mailbox, so only set this if yours allows it.
MAIL_FROM=

# --- LLM provider (phase 2) ----------------------------------------------
# Unset LLM_PROVIDER resolves to: gemini when NODE_ENV=production, else claude.
# The resolved provider is logged once at boot.
# LLM_PROVIDER=claude
GOOGLE_API_KEY=

# HOW to reach Claude. Two doors to the same Haiku and Opus - the prompts, the
# schemas and the provenance guard are identical either way, and only the
# credentials and the model ids differ.
#
#   api-key  (default)  the Anthropic API. One value, below. Nothing else.
#   bedrock             AWS Bedrock. Needs a region and AWS credentials, and the
#                       models enabled in that region.
#
# Whichever is selected, the boot log prints the mode, both model ids, and a
# warning naming the variable that is missing. Nothing here is required to start
# the app: discovery and profile ingestion do not touch an LLM, and scoring and
# tailoring fail at the first call with a message that says what to set.
CLAUDE_AUTH_MODE=api-key

# --- CLAUDE_AUTH_MODE=api-key --------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- CLAUDE_AUTH_MODE=bedrock --------------------------------------------
# A SHELL THAT ALREADY EXPORTS AWS_* WINS OVER THIS FILE. dotenv does not
# overwrite a variable that is already set, so `export AWS_ACCESS_KEY_ID=...` in
# a profile for another account silently takes precedence over everything below.
# `env | grep AWS_` if the boot log names credentials you did not put here.
#
# REQUIRED. It selects the endpoint (bedrock-mantle.<region>.api.aws) and with it
# which region your model access applies in, so there is nothing to default it to.
# Set it to the region where you enabled Claude in the Bedrock console - model
# access is granted per model, per region, and a model you have not been granted
# is rejected as a bad request rather than as a permissions error.
AWS_REGION=ap-south-1

# Credentials, in precedence order. Set ONE group and leave the rest blank.
#
#   1. A Bedrock API key from the AWS console (Bedrock -> API keys). Simplest:
#      one value, no IAM user, no SigV4.
AWS_BEARER_TOKEN_BEDROCK=
#   2. An IAM user or role with bedrock:InvokeModel. Both halves or neither -
#      half a pair is not a credential. The session token is only for temporary
#      role credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
#   3. Neither, in which case the AWS provider chain is asked - ~/.aws/
#      credentials, SSO, or an instance role. This is the right answer on EC2
#      and the reason none of the above is required.

# Bedrock model ids. Normally leave both blank: Bedrock takes the same model
# names behind an `anthropic.` prefix, so the provider sends
# anthropic.claude-haiku-4-5 and anthropic.claude-opus-5, and the boot log prints
# exactly what it will send. The region is a property of the connection, not of
# the id - there is no us. / eu. / apac. prefix on this path.
#
# Set these only for the two things the prefix cannot express: a
# provisioned-throughput ARN, or pinning a dated snapshot (…-20251001-v1:0) in an
# account where the alias is not what you have been granted. What you do need
# either way is model access, requested per model per region in the Bedrock
# console - without it the call is rejected as a bad request, and the error this
# project raises says so.
BEDROCK_MODEL_FAST=
BEDROCK_MODEL_DEEP=

# --- Assisted submission (phase 6) ---------------------------------------
# Where Chrome keeps the logged-in session it uses to open application forms.
# You sign in to the boards ONCE, by hand, in that window; the cookies live here
# afterwards. TREAT THIS DIRECTORY AS CREDENTIALS - anyone who can read it is
# signed in as you, on every board you have used. It is gitignored, and it must
# stay that way.
#
# Leave blank for .browser-profile/ in the repo root.
BROWSER_PROFILE_DIR=

# Where the screenshot of each filled form is written. One PNG per attempt,
# timestamped rather than overwritten, so a form filled badly yesterday and
# correctly today is two pieces of evidence. These images contain your phone
# number, your address and whatever the form asked - also gitignored.
#
# Leave blank for .artifacts/submissions/.
SUBMISSION_SHOT_DIR=

# --- Notifications (phase 7) ---------------------------------------------
# The 09:00 IST digest. It is always written to the database and shown at
# /app/digest, so the settings below only decide whether a COPY reaches you
# somewhere else - nothing here can lose a digest.
#
# EMAIL uses the SMTP block near the top of this file. With SMTP_HOST unset the
# digest is built and the run says which setting was missing.
#
# TELEGRAM is optional and off when either value is blank. Both come from
# talking to @BotFather (the token) and to @userinfobot (your chat id).
#
# ONE CHAT ID, WHICH MEANS ADMINS ONLY. This is a single operator-level chat, so
# only an ADMIN account's digest is sent to it - another candidate's shortlist
# must not arrive on your phone. TREAT THE TOKEN AS A PASSWORD: anyone holding
# it can post as your bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discovery politeness (phase 1) --------------------------------------
# REQUIRED FOR DISCOVERY. Sent on every outbound job-board request as part of
# the User-Agent. Use a real address: it is how a site operator reaches you
# instead of silently blocking. See PLAN-v2 1d.
#
# Discovery FAILS CLOSED without it - `npm run cli -- discover`, the probe
# command and the 06:00 cron all refuse to send a single request rather than
# make anonymous ones. The api and web app still start, deliberately: this is a
# setting only the fetch uses, so a missing value should break the fetch and not
# your login.
DISCOVERY_CONTACT_EMAIL=
