node_modules/
dist/
coverage/
.env
# Per-machine overrides. Note frontend/.env IS committed - it holds only the
# public NEXT_PUBLIC_API_URL, and a fresh clone needs it.
*.local
!frontend/.env
*.log

# Build output and local task caches.
.next/
.turbo/
next-env.d.ts
# tsc --noEmit still writes an incremental cache. It is machine-local, it churns
# on every typecheck, and a stale one committed by someone else causes confusing
# "already built" skips.
*.tsbuildinfo

# Generated artifacts
/artifacts/
/backend/prisma/generated/

# Scratch. NOT anchored to the repo root, because the paths that land here are
# relative to the process cwd and the cli/worker run from backend/ - an anchored
# rule would miss backend/.artifacts entirely.
.artifacts/

# Tailored resumes (phase 5, RESUME_OUTPUT_DIR, default backend/generated-resumes).
# Every file in here carries the candidate's real name, phone number and email.
# Unanchored for the same reason as .artifacts. The name is not `resumes/` on
# purpose: unanchored, that would also ignore frontend/src/app/app/resumes/.
generated-resumes/

# Uploaded resumes (RESUME_UPLOAD_DIR, default backend/uploads). The candidate's
# own file, whole - name, phone number, address, employers. Unanchored for the same
# reason as .artifacts above: the default is relative to the process cwd, which is
# backend/ for the API. This is the one directory in the tree that holds a document
# a person handed over rather than something the code generated.
uploads/

# Playwright's persistent browser profile for the submit session (phase 6).
# Contains live login cookies for job sites - must never be committed.
#
# UNANCHORED, for the same reason as .artifacts above, and this rule was wrong until it
# was: the path is relative to the process cwd and the cli runs from backend/, so the
# profile lands at backend/.browser-profile and an anchored `/.browser-profile/` matched
# nothing at all. 202 files of Cookies, Login Data and Web Data sat untracked but not
# ignored, one `git add -A` from a commit.
.browser-profile/

# Spike scripts kept for reference; their output data is disposable.
/spike/*.json

# Local pre-migration database dumps. Real candidate data, and large.
.backups/

# Local embedding model weights (~130MB, re-downloadable)
.models/
