// Data model for PLAN-v2.txt section 2.
//
// Two notes that explain otherwise-odd choices in this file:
//
// 1. EMBEDDINGS. Prisma has no `vector` type, so embedding columns are declared
//    Unsupported("vector(384)") and are invisible to the generated client.
//    Reads and writes go through raw SQL over @prisma/adapter-pg. The dimension
//    is 384 because embeddings come from local bge-small-en-v1.5, chosen so
//    there is no second paid API (PLAN.txt constraint 2).
//
//    CONSEQUENCE WHEN YOU RUN `migrate dev`: the HNSW indexes on those columns
//    are invisible to Prisma too, so the differ sees an index that exists in the
//    database and is declared nowhere, and helpfully emits
//    `DROP INDEX "job_postings_embedding_hnsw_idx"` (and the profile_atoms one)
//    into your new migration. DELETE THOSE LINES before applying. Prisma 7.10
//    rejects `type: Hnsw` in the schema, so the indexes cannot be declared here
//    and the differ cannot be quietened. Applying the drop breaks nothing
//    loudly - semantic search just degrades to a sequential scan.
//
// 2. TENANT-ABSENCE. CompanyProbe exists because Keka, Zoho Recruit and
//    Darwinbox all return HTTP 200 for companies that do not exist. Probe
//    results must be remembered so a dead slug is never retried, and so a
//    "miss" is distinguishable from a "tenant not found".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // No `url` here. Prisma 7 takes the connection string from prisma.config.ts,
  // which loads the repo-root .env - so this block looks incomplete but is not.
  //
  // Kept INSIDE the braces on purpose: `prisma generate` runs its formatter over
  // this file and silently deletes comments sitting above a datasource block.
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ACCOUNTS  (PLAN-v2 section 2A)
// ---------------------------------------------------------------------------

/// ADMIN operates the machine and uses it as a candidate. USER only uses it.
/// The distinction is enforced by a server-side guard on every admin route;
/// hiding a nav link is not access control (2A.1).
enum Role {
  ADMIN
  USER
}

model User {
  id    String @id @default(uuid())
  email String @unique
  name  String
  role  Role   @default(USER)

  /// scrypt. Format: "scrypt$N$r$p$<salt-b64>$<hash-b64>", so the cost
  /// parameters travel with the hash and can be raised without invalidating
  /// existing passwords. node:crypto rather than bcrypt/argon2 - no native
  /// build, no new dependency, adequate for a handful of accounts (2A.6).
  passwordHash String

  /// Whether this account may sign in AT ALL. Self-signup creates it false.
  active Boolean @default(true)

  /// When an admin let a self-signed-up account in, and who did it.
  ///
  /// Separate from `active` on purpose, because the two answer different
  /// questions and the admin queue needs to tell them apart:
  ///
  ///   approvedAt NULL  + active false -> new signup, never reviewed
  ///   approvedAt set   + active false -> approved once, since suspended
  ///   approvedAt set   + active true  -> normal account
  ///
  /// Collapsing these into one boolean would put a brand-new stranger and an
  /// account you deliberately suspended in the same bucket, which is exactly the
  /// distinction the reviewer is trying to make.
  approvedAt   DateTime?
  approvedById String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions         Session[]
  passwordResets   PasswordReset[]
  profiles         CandidateProfile[]
  skillsReserve    SkillsReserve[]
  matchScores      MatchScore[]
  applications     Application[]
  answers          ApplicationAnswers?
  digests          DailyDigest[]
  jobPreference    JobPreference?
  blockedEmployers BlockedCompany[]
  settingsTouched  AppSetting[]
  tailored         TailoredResume[]
  tracked          TrackedApplication[]
  contacts         TrackedContact[]
  gmail            GmailConnection?
  emailSuggestions EmailSuggestion[]

  @@index([role])
  /// The admin approval queue: pending accounts, oldest first.
  @@index([active, approvedAt])
  @@map("users")
}

/// One REFRESH token. Opaque and random - it carries no claims, so nothing about
/// a session is client-assertable, and revocation is immediate because it is a
/// row rather than a signature.
///
/// A login opens a FAMILY. Each refresh exchanges the current token for a new row
/// in the same family and stamps the old one `rotatedAt`. A rotated token being
/// presented a second time can only mean it was captured (the legitimate client
/// already threw its copy away), so that revokes the entire family rather than
/// just the one row - a thief who used it once must not be able to keep going,
/// and neither should whoever they stole it from continue unaware.
///
/// The column names are the ORIGINAL ones (`tokenHash`, `expiresAt`) via @map.
/// The field names changed because their meaning narrowed from "the session
/// token" to "the refresh token specifically"; the columns did not, so this
/// migration adds and never drops. Renaming them would have bought a tidier
/// dump for a destructive migration, which is a bad trade.
model Session {
  id               String @id @default(uuid())
  /// SHA-256 of the refresh cookie. The raw token is never stored, so a database
  /// dump does not hand over live sessions.
  refreshTokenHash String @unique @map("tokenHash")
  userId           String

  /// Shared by every rotation descending from one login. This is the unit of
  /// revocation, not the individual row.
  familyId String

  /// Sliding window. Extended on each refresh, but never past absoluteExpiresAt.
  refreshExpiresAt DateTime @map("expiresAt")

  /// Hard ceiling set at login. Rotation cannot push past it, so a continuously
  /// refreshed session still ends and a silently-stolen cookie is not a
  /// permanent grant.
  absoluteExpiresAt DateTime

  /// Set when this token has been exchanged. Presenting it again after this is
  /// the reuse signal described above.
  rotatedAt     DateTime?
  revokedAt     DateTime?
  /// Why it died - "logout", "reuse-detected", "password-change". Read by nobody
  /// in code; it exists so the sessions table can answer "what happened here?"
  revokedReason String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens AccessToken[]

  @@index([userId])
  @@index([familyId])
  @@index([refreshExpiresAt])
  @@map("sessions")
}

/// One SHORT-LIVED access token, which is what actually authorises a request.
///
/// Opaque and stored, not a JWT. That means every request costs one indexed
/// lookup, and buys the property the whole design rests on: disabling an account
/// or detecting a stolen refresh token ends access immediately, with no window
/// during which a signature is still honoured.
model AccessToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  sessionId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("access_tokens")
}

/// A pending password reset. Single-use, short-lived, and only the hash is kept -
/// the emailed token is the only copy, exactly like a session cookie.
///
/// Rows are kept after use rather than deleted, so `usedAt` can distinguish "this
/// link was already used" from "this link never existed". Both refuse the reset;
/// only one of them means someone should worry.
model PasswordReset {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  /// Recorded to make "who has been asking for resets on my account" answerable.
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

/// Non-secret operational settings, admin-editable.
///
/// SECRETS ARE NOT HERE and never will be. API keys stay in .env; the admin UI
/// reports only whether each integration is configured. Writing credentials
/// through a web form turns one gitignored file into a column, a request body,
/// a log line and a response - four new leak paths - to save one text-editor
/// visit. See PLAN-v2 2A.4.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  /// SetNull, not Cascade: deleting the admin who last changed a setting must not
  /// delete the setting. It was an unconstrained String before, which meant it
  /// could hold an id belonging to nobody - "who changed this?" answerable only
  /// by a lookup that returns nothing.
  updatedBy     String?
  updatedByUser User?   @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([updatedBy])
  @@map("app_settings")
}

/// v1's config/legal.yaml, now per-user and USER-WRITABLE ONLY.
///
/// An admin can see that these are unfilled - it blocks the pipeline - but
/// cannot fill them. Guessing someone else's visa status or expected salary
/// onto a real job application is worse than a blocked pipeline (2A.5).
///
/// EEO/demographic fields are deliberately absent from this model entirely.
/// They are never stored, never inferred and never auto-filled; the form filler
/// leaves them at "decline to self-identify".
/// Where this candidate is willing to work, as THEY state it.
///
/// WHY THIS IS A TABLE AND NOT config/targets.yaml. The location rule is the one
/// stage-1 rule whose right answer is a fact about a person rather than about the
/// job market: which cities they would move to, and whether a remote role in
/// another country is worth an application. Keeping it in the YAML meant editing a
/// file on the server to answer a question only the candidate can answer, and the
/// default four cities silently rejected 31 real Indian postings - MongoDB in
/// Gurugram, Freshworks in Chennai, Bosch in Coimbatore - with no trace anywhere
/// that a preference had been guessed on their behalf.
///
/// ABSENT MEANS "USE THE FILE". A candidate who has never opened the screen gets
/// config/targets.yaml's rule, unchanged. That keeps this additive: no migration
/// has to invent a preference for an existing account, and nothing about matching
/// changes until somebody deliberately states what they want.
///
/// EVERY FIELD IS A WIDENING OR A NARROWING OF ONE RULE, so the combination is
/// always meaningful: cities and `anywhereInIndia` decide which PLACES pass, and
/// the three remote flags decide which kinds of REMOTE pass. See
/// src/config/locations.ts, which is the only place these become a filter.
model JobPreference {
  userId String @id

  /// City ids from src/config/india-cities.ts, e.g. ["bengaluru", "delhi-ncr"].
  ///
  /// IDS, NOT MATCH TERMS. "Delhi NCR" is one choice a person makes and six words
  /// a posting might use (new delhi, gurgaon, gurugram, noida, faridabad,
  /// ghaziabad); storing the words would freeze today's spelling list into every
  /// row, so adding an alias later would require a data migration instead of a
  /// one-line edit to the catalogue.
  ///
  /// Kept even while `anywhereInIndia` is on, so turning that off restores the
  /// list the candidate had chosen rather than an empty screen.
  cities String[]

  /// Any location in India passes, whatever the city.
  ///
  /// When true the city list is not consulted. This is not the same as ticking
  /// every city in the catalogue: the catalogue is a list of places worth offering
  /// as choices, and India has hundreds of towns that are not on it.
  anywhereInIndia Boolean @default(false)

  /// A remote role that states India. Almost always wanted, hence the default.
  remoteIndia Boolean @default(true)

  /// A remote role that names no country at all.
  ///
  /// Default true because Indian postings routinely say only "Remote", and stage 3
  /// reads the description for a timezone or work-authorisation requirement. The
  /// cost of a false positive here is one LLM call, not an application.
  remoteUnspecified Boolean @default(true)

  /// A remote role that states a region the candidate is not in - "Remote, USA".
  ///
  /// DEFAULT FALSE, and the one flag that should stay off unless it is meant.
  /// PLAN-v2's measurement: 509 postings tagged remote were not India-eligible,
  /// and "Remote - US" is not a remote job, it is a job in the US that needs a
  /// visa. Some employers do hire from India this way, which is why the switch
  /// exists at all.
  remoteOutsideIndia Boolean @default(false)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("job_preferences")
}

/// Employers this candidate will not work for, in their own words.
///
/// THE ONE STAGE-1 RULE THAT IS ABOUT A RELATIONSHIP RATHER THAN ABOUT A JOB. Every
/// other rule asks whether the posting is a fit; this one says the fit is irrelevant.
/// The reasons are ordinary and none of them are inferable from a description - a
/// previous employer, a company that already rejected them, an agency that spams, a
/// client the candidate is under a non-compete with. No amount of reading the posting
/// can produce that answer, so it has to be stored.
///
/// PER USER, not global, and that is deliberate even on a single-candidate install.
/// `Company.active` already exists and would have been the cheaper place to put this -
/// but it is an operational flag about whether a BOARD is worth fetching, and turning
/// it off would stop the crawl for everybody and lose the postings from the pool
/// entirely. A skip is not a reason to stop looking; it is a reason not to apply.
///
/// TEXT, NOT A `Company` FOREIGN KEY, and this is the decision most worth defending.
/// A candidate knows the employer's name before this system has ever heard of it - the
/// company row appears only once some board has been crawled, which for the employer
/// they just left may be never. A foreign key would make the rule unstatable until the
/// pipeline happened to discover the company, i.e. exactly too late. So the rule is
/// stored as words and matched against whatever names turn up, and the matching lives
/// in one pure function (src/config/blocked-companies.ts) so that every surface - the
/// screen, the apply plan, the suggestion list - agrees about what "Hyscaler" covers.
model BlockedCompany {
  id     String @id @default(uuid())
  userId String

  /// What the candidate typed, kept verbatim so the screen can show it back.
  label String

  /// `label` through `normalizeCompany`. Stored rather than derived on read because
  /// it is what the unique index is built on: "HyScaler" and "hyscaler pvt ltd " are
  /// one rule entered twice, and a list that accepts both is a list the candidate
  /// cannot keep tidy.
  pattern String

  /// Why, in their own words. Optional, never sent anywhere, and the reason it exists
  /// is that a blocklist read six months later is a set of names with no story.
  reason String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([userId])
  @@map("blocked_companies")
}

model ApplicationAnswers {
  userId String @id

  workAuthorization String? /// e.g. "Indian citizen, no sponsorship required"
  needsSponsorship  Boolean?
  noticePeriodDays  Int?

  /// Decimal, not Float. These are money, and they get typed into a real
  /// employer's salary field - a binary float cannot represent 12.1 exactly, so
  /// Float turns a figure the candidate entered into one they did not. Decimal(6,2)
  /// holds up to 9999.99 LPA at exactly two places.
  currentCtcLpa  Decimal? @db.Decimal(6, 2)
  expectedCtcLpa Decimal? @db.Decimal(6, 2)

  willingToRelocate Boolean?
  earliestStartDate DateTime?
  /// Free-form { question: answer } for recurring screening questions the
  /// candidate has already answered by hand once.
  customAnswers     Json?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("application_answers")
}

// ---------------------------------------------------------------------------
// PROFILE
// ---------------------------------------------------------------------------

/// Canonical truth about the candidate. The atom list is the ONLY thing
/// tailoring may draw from - see ResumeVariant and PLAN-v2 phase 5.
model CandidateProfile {
  id        String  @id @default(uuid())
  userId    String
  /// e.g. "primary". Unique PER USER, not globally - two candidates both
  /// naming their profile "primary" is normal.
  label     String
  fullName  String
  email     String
  phone     String?
  location  String?
  linkedIn  String?
  github    String?
  portfolio String?

  /// Whole-profile vector. Per-atom vectors live on ProfileAtom.
  embedding Unsupported("vector(384)")?

  sourceResumePath String?
  /// The filename the candidate uploaded, kept for display only. The stored file
  /// is renamed to a uuid, so without this the resume list could show nothing but
  /// a row of uuids - and "which of these three did I upload in August" is the
  /// whole question that screen answers.
  sourceFilename   String?
  confirmedAt      DateTime? /// null until the human confirmation gate passes

  /// The resume matching and tailoring use when nothing names one explicitly.
  ///
  /// Needed the moment a candidate can hold more than one. Both funnels used to
  /// REFUSE when they found several profiles, because picking the wrong one
  /// yields a complete, plausible, wrong shortlist - a hard failure was the only
  /// safe default with no way to express intent. This column is that way.
  ///
  /// At most one row per user may be true, enforced by a partial unique index in
  /// the migration (Postgres `WHERE "isActive"`, which Prisma's schema language
  /// cannot express - `@@unique([userId, isActive])` would instead permit exactly
  /// one INACTIVE resume, the opposite of the rule). Zero is legal: a candidate
  /// mid-upload with nothing confirmed has no active resume.
  isActive Boolean @default(false)

  /// How this resume is typeset, everywhere it is rendered - the preview, the
  /// pipeline's variants and the ones tailored by hand.
  ///
  /// ON THE RESUME AND NOT ON THE USER. A candidate holding two resumes holds them
  /// because they are aimed at different things, and "the compact one-pager" is
  /// exactly that kind of difference. A per-user setting would retypeset all of them
  /// when the candidate changed one.
  resumeTemplate ResumeTemplate @default(CLASSIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  atoms          ProfileAtom[]
  resumeVariants ResumeVariant[]
  tailored       TailoredResume[]

  @@unique([userId, label])
  @@index([userId])
  @@map("candidate_profiles")
}

enum AtomKind {
  BULLET
  SKILL
  ROLE
  EDU
}

/// One row per atom - the smallest unit of truth about the candidate, and the
/// ONLY thing tailoring may draw from.
///
/// WAS a `atoms Json` column on CandidateProfile with a parallel
/// `profile_atom_embeddings` table keyed by an `atomId` that lived inside that
/// JSON. That is a foreign key Postgres cannot enforce: editing the JSON to drop
/// an atom left its embedding row behind, still matchable against a JD, so
/// tailoring could surface a bullet the candidate had deleted. A real table with
/// a real FK and ON DELETE CASCADE makes that state unreachable rather than
/// merely unlikely.
///
/// The embedding moved here too, so there is one row per atom instead of two
/// that have to be kept in step.
model ProfileAtom {
  id        String   @id @default(uuid())
  profileId String
  kind      AtomKind
  text      String   @db.Text

  /// Tech tags and quantified results, stayed as arrays on purpose. Nothing
  /// references an individual tag by identity - the provenance guard consumes
  /// them as a set of strings - so promoting them to tables would add two joins
  /// and remove no failure mode. Contrast the atom id above, which WAS being
  /// referenced.
  tech    String[]
  metrics String[]

  employer     String?
  dateRange    String?
  link         String?
  ctc          String?
  degree       String?
  fieldOfStudy String?
  score        String?
  scoreOutOf   String?

  /// Display order within the profile. Explicit because the resume's ordering is
  /// a human decision, and `ORDER BY createdAt` would silently reshuffle a
  /// profile after an atom is re-ingested.
  ordinal Int

  /// Per-atom vector, so an atom can be matched to a JD individually rather than
  /// only via the whole-profile vector.
  embedding Unsupported("vector(384)")?

  /// Hash of the `text` the vector above was computed from. When it stops
  /// matching, the vector is stale and must be recomputed - the same staleness
  /// check JobPosting.contentHash performs. Null until first embedded.
  ///
  /// This is the one duplicated value kept here deliberately: without it, an
  /// edited atom keeps a vector describing its OLD text, and nothing anywhere
  /// says so.
  embeddedTextHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, ordinal])
  @@index([profileId, kind])
  @@map("profile_atoms")
}

/// Skills the candidate genuinely has but chose not to list on the resume.
/// EMPTY BY DEFAULT: facts-only tailoring was the decision. It exists so that
/// widening the provenance guard's allowed-tech union later is a config change
/// rather than a rewrite of the guard.
model SkillsReserve {
  id        String   @id @default(uuid())
  userId    String
  skill     String
  note      String?
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@map("skills_reserve")
}

// ---------------------------------------------------------------------------
// COMPANIES AND SOURCES
// ---------------------------------------------------------------------------

enum AtsType {
  GREENHOUSE
  LEVER
  ASHBY
  SMARTRECRUITERS
  WORKABLE
  WORKDAY /// discovered and linked, never auto-filled (PLAN-v2 phase 6)
  CAREERS_API /// an employer's own careers-site JSON (Atlassian) - linked, never auto-filled
  CUSTOM /// in-house form - handled by the generic form filler
  UNKNOWN
}

/// Pay proxy, and the PRIMARY pay signal in this system.
///
/// The spike found structured salary on 2 of 699 India postings (0.3%), and
/// both were junk. So posting salary cannot rank Indian jobs; company tier is
/// what does the work. Bands are starting estimates to calibrate against real
/// offers, NOT researched figures - see PLAN-v2 change 2.
enum CompanyTier {
  T1_GLOBAL_INDIA_OFFICE /// ~Rs 25-50 LPA. Highest yield found in the spike.
  T2_FUNDED_INDIAN_STARTUP /// ~Rs 18-35 LPA
  T3_INDIAN_MIDMARKET /// ~Rs 8-18 LPA. The actual target band.
  T4_SERVICES_STAFFING /// ~Rs 6-12 LPA. Kept, ranked last.
  UNKNOWN
}

model Company {
  id       String      @id @default(uuid())
  name     String
  slug     String      @unique
  domain   String?
  atsType  AtsType     @default(UNKNOWN)
  /// Board identifier on the ATS. For Greenhouse/Lever/Ashby this is the URL
  /// token; for SmartRecruiters the company id.
  atsToken String?
  tier     CompanyTier @default(UNKNOWN)
  isAgency Boolean     @default(false)

  /// { lastFetchedAt, postingsSeen, reachableSeen, consecutiveEmptyRuns }
  /// Drives pruning: a board that keeps returning nothing drops to a weekly
  /// fetch so the list can grow 10x without the daily run slowing down.
  yieldStats Json?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postings     JobPosting[]
  applications Application[]

  @@unique([atsType, atsToken])
  @@index([atsType, active])
  @@index([tier])
  @@map("companies")
}

enum ProbeResult {
  HIT
  MISS /// clean 404 - slug is not on this ATS
  TENANT_NOT_FOUND /// HTTP 200 but the body says the tenant is absent
  FORBIDDEN /// tenant exists, board not publicly readable
  ERROR
}

/// Every slug guess and its outcome, so the list builder never re-probes a
/// known-dead slug. Blind slug guessing hit ~24% in the spike, which is high
/// enough to be the primary list-growth technique - but only if attempts are
/// remembered.
model CompanyProbe {
  id         String      @id @default(uuid())
  slugTried  String
  atsType    AtsType
  result     ProbeResult
  httpStatus Int?
  jobsFound  Int?
  notes      String?
  probedAt   DateTime    @default(now())

  @@unique([slugTried, atsType])
  @@index([result])
  @@map("company_probes")
}

/// Per-connector run log. Makes a silently-dead connector visible, which is the
/// main failure mode of depending on undocumented endpoints.
model SourceRun {
  id             String    @id @default(uuid())
  source         String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  companiesTried Int       @default(0)
  postingsSeen   Int       @default(0)
  postingsNew    Int       @default(0)
  errors         Int       @default(0)
  errorSample    Json?

  @@index([source, startedAt])
  @@map("source_runs")
}

// ---------------------------------------------------------------------------
// POSTINGS
// ---------------------------------------------------------------------------

enum RemoteType {
  ONSITE
  HYBRID
  REMOTE_INDIA /// applicable
  REMOTE_GLOBAL /// applicable
  REMOTE_OTHER_REGION /// NOT applicable - e.g. "Remote - US"
  UNKNOWN
}

/// Where a salary figure came from. STATED is rare enough in India (0.3%) that
/// the ESTIMATED and UNKNOWN paths are the normal case, not the exception.
enum SalarySource {
  STATED
  ESTIMATED
  UNKNOWN
}

/// What salaryMin/salaryMax are denominated over.
///
/// Was a free String. The live data already held both `null` and `'year'`, and
/// nothing stopped a connector writing `'yearly'`, `'annual'` or `'YEAR'` next -
/// at which point a salary filter silently skips those rows instead of failing.
/// An enum makes the set closed and the mistake a write error.
enum SalaryPeriod {
  YEAR
  MONTH
  DAY
  HOUR
}

model JobPosting {
  id          String  @id @default(uuid())
  source      String /// connector id: 'greenhouse' | 'lever' | ...
  sourceJobId String
  companyId   String?

  title           String
  normalizedTitle String
  descriptionRaw  String @db.Text
  descriptionText String @db.Text

  location   String?
  remoteType RemoteType @default(UNKNOWN)
  seniority  String?
  yoeMin     Int?
  yoeMax     Int?

  /// Decimal, not Int. An hourly or monthly figure is not a whole number, and
  /// Int silently truncated it. Decimal(14,2) covers an annual INR figure with
  /// room to spare.
  salaryMin Decimal? @db.Decimal(14, 2)
  salaryMax Decimal? @db.Decimal(14, 2)

  /// ISO 4217, three upper-case letters - enforced by a CHECK rather than an enum
  /// because the value set is large, externally defined, and not ours to close.
  salaryCurrency   String?
  salaryPeriod     SalaryPeriod?
  salarySource     SalarySource  @default(UNKNOWN)
  salaryConfidence Float?

  applyUrl String
  atsType  AtsType   @default(UNKNOWN)
  postedAt DateTime?

  /// Hash of the normalized content. Changes when the employer edits the
  /// posting, which is how a re-scored posting is distinguished from a new one.
  contentHash String
  embedding   Unsupported("vector(384)")?

  /// The `contentHash` this row's `embedding` was computed from.
  ///
  /// Without it a stale vector is undetectable. The discovery upsert overwrites
  /// `descriptionText` and `contentHash` when an employer edits a posting, and it
  /// CANNOT touch `embedding` - Prisma has no type for that column, so it is not in
  /// the update payload at all. The result would be a vector describing the old
  /// description, still matching, forever, with nothing to compare it against.
  ///
  /// So stage 2 re-embeds when this differs from `contentHash`, and the CHECK
  /// constraint on the table makes "has a vector but no hash" unrepresentable -
  /// which is the state a raw-SQL write that forgot this column would create.
  embeddedContentHash String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  closedAt    DateTime?

  company        Company?         @relation(fields: [companyId], references: [id])
  matchScores    MatchScore[]
  applications   Application[]
  resumeVariants ResumeVariant[]
  tailored       TailoredResume[]

  @@unique([source, sourceJobId])
  @@index([contentHash])
  @@index([normalizedTitle])
  @@index([postedAt])
  @@index([atsType])
  @@map("job_postings")
}

// ---------------------------------------------------------------------------
// MATCHING
// ---------------------------------------------------------------------------

enum MatchVerdict {
  STRONG
  GOOD
  BORDERLINE
  WEAK
  REJECT
}

/// The candidate's own answer to a scored posting, collected by the morning
/// digest (phase 7).
///
/// THIS IS NOT AN ApplicationStatus, and it deliberately does not live on the
/// Application table. Saying "not for me" from a phone at breakfast is an
/// opinion about a posting; it is not an application, and writing one would put
/// a row in the table that answers "what did we send" describing something that
/// was never sent. It also has to be recorded BEFORE an Application exists,
/// because the entire saving is skipping the tailoring call that would create
/// one.
///
/// UNDECIDED is the default and behaves like WANTED everywhere: an unread digest
/// must never stop the pipeline. Only NOT_WANTED subtracts.
enum MatchDecision {
  UNDECIDED
  WANTED
  NOT_WANTED
}

/// A score is profile-x-job, so it is per-user. The same posting can be STRONG
/// for one candidate and REJECT for another; a shared score table would be
/// meaningless.
model MatchScore {
  id      String       @id @default(uuid())
  userId  String
  jobId   String
  score   Int /// 0-100
  verdict MatchVerdict

  reasons       String[]
  missingSkills String[]

  /// Decimal for the same reason as ApplicationAnswers.currentCtcLpa: this figure
  /// is shown to the candidate as a number to negotiate against.
  estimatedSalaryLPA Decimal? @db.Decimal(6, 2)

  salaryConfidence Float?

  /// Recorded so a quality regression can be traced to a provider. This is one
  /// of the four defenses against the two environments quietly diverging.
  llmProvider String
  model       String

  vectorDistance Float?
  scoredAt       DateTime      @default(now())
  /// What the candidate said in the digest. Read by TailoringService.shortlist
  /// and SubmissionService, both of which skip NOT_WANTED.
  ///
  /// RE-SCORING MUST NOT RESET THIS. The upsert in matching.service.ts builds its
  /// `data` object from the scoring result only and never mentions these two
  /// columns, so an edited posting can change the score and the verdict while the
  /// candidate's "no" survives. A re-score that silently un-rejected a posting
  /// would apply to something the candidate had already turned down.
  decision       MatchDecision @default(UNDECIDED)
  decidedAt      DateTime?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// One current score per candidate per posting. Re-scoring after the employer
  /// edits a posting (contentHash change) updates this row rather than adding a
  /// second one, so "how many jobs has this user been scored against" is a
  /// count, not a distinct-count that could quietly go wrong.
  @@unique([userId, jobId])
  @@index([jobId])
  @@index([userId, score])
  @@index([userId, decision])
  @@map("match_scores")
}

// ---------------------------------------------------------------------------
// TAILORING
// ---------------------------------------------------------------------------

model ResumeVariant {
  id        String @id @default(uuid())
  profileId String
  jobId     String

  /// { selectedAtomIds[], rewrites: [{atomId, text}], headline }
  atomSelection Json
  coverLetter   String? @db.Text
  docxPath      String?
  pdfPath       String?

  /// Provenance guard output. Retained even when the variant PASSES: a rising
  /// violation rate across variants is the early signal that the prompt is
  /// drifting, and that is only visible if passes are recorded too.
  provenanceReport Json
  guardPassed      Boolean

  /// Which provider and model produced this variant, for the same reason
  /// MatchScore records them - a quality regression has to be traceable to one.
  /// It matters more here than for scoring: `guardPassed` above is the drift
  /// signal PLAN asks the digest to report, and a rising failure rate is not
  /// interpretable without knowing which model the rate belongs to. Two
  /// environments running different providers would otherwise average into one
  /// meaningless number.
  ///
  /// Nullable because rows predating this column exist.
  llmProvider String?
  model       String?

  createdAt DateTime @default(now())

  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job          JobPosting       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([jobId])
  @@index([guardPassed])
  @@map("resume_variants")
}

/// How a resume is TYPESET. Not what it says, and not what order it says it in.
///
/// Every template prints the same blocks in the same order, because that order is
/// the ATS contract - see resume.render.ts, whose whole header is a list of layout
/// features that reorder or hide text on the way into a parser. What a template is
/// allowed to change is margins, sizes, weights, alignment and rules. So switching
/// template can change how many pages the resume runs to and cannot change a single
/// word of it.
///
/// CLASSIC is the default and must stay byte-identical to what this system rendered
/// before templates existed: resumes already sent to employers were rendered by it,
/// and a candidate re-downloading one should get the document they sent.
enum ResumeTemplate {
  CLASSIC /// centred name, ruled section headings, 11pt, one-inch margins
  COMPACT /// same document, tightened to fit a page - 10pt, 0.6in margins
  MODERN /// left-aligned name, larger coloured headings, more air between sections
}

/// A resume the CANDIDATE asked for, against a JD they chose.
///
/// A SEPARATE TABLE FROM ResumeVariant, which is the pipeline's. The two look
/// alike and are not the same thing, and the difference is `jobId`: a variant
/// belongs to a posting this system discovered and scored, and the apply flow,
/// the digest's drift report and `Application.resumeVariantId` all assume that
/// posting exists. A pasted job description has no posting. Making
/// `ResumeVariant.jobId` nullable to fit would have put a row with no job into
/// every one of those queries, and each would have had to learn a state it has
/// no use for. So the lane a person drives by hand is its own table.
///
/// WHAT IS THE SAME, deliberately: the atoms it draws from, the prompt, the
/// provenance guard and the renderer. There is no second template and no second
/// set of rules about what may be claimed - only a different way of choosing the
/// job description.
model TailoredResume {
  id        String  @id @default(uuid())
  userId    String
  profileId String
  /// Set when the JD came from a discovered posting, null when it was pasted in.
  /// Null on purpose rather than a placeholder posting: a synthetic row in
  /// job_postings would be scored, matched and shown as a job to apply to.
  jobId     String?

  /// What the resume was aimed at. Copied rather than joined even when `jobId`
  /// is set, because a posting is edited and taken down by its employer and this
  /// row has to keep saying what it was tailored for.
  title   String
  company String
  /// The description as it was used. Kept so a re-run is honest about what the
  /// model actually read, and so the list can show what a pasted JD was.
  jdText  String @db.Text

  /// { selectedAtomIds[], rewrites: [{atomId, text}], headline }
  atomSelection Json
  coverLetter   String? @db.Text
  docxPath      String?
  pdfPath       String?

  /// Which template the files above were written in.
  ///
  /// Recorded rather than read from the profile, because the profile's template
  /// changes and these files do not. Without it, re-typesetting a past run would
  /// have to guess what it currently is, and the screen offering the switch would
  /// show the wrong one as selected.
  template ResumeTemplate @default(CLASSIC)

  /// Same guard, same report shape as ResumeVariant. A FAILED row is still
  /// written and still points at rendered files - they hold the BASE resume,
  /// which is what the candidate gets when a rewrite could not be trusted.
  provenanceReport Json
  guardPassed      Boolean

  llmProvider String?
  model       String?

  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     JobPosting?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// The list on the tailor screen: this candidate's, newest first.
  @@index([userId, createdAt])
  @@index([profileId])
  @@index([jobId])
  @@map("tailored_resumes")
}

// ---------------------------------------------------------------------------
// APPLICATIONS
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  QUEUED
  AWAITING_REVIEW
  APPROVED
  REJECTED /// rejected by the human from the digest
  PREPARED /// form filled, waiting on the human to submit
  SUBMITTED /// only on DETECTED confirmation, never optimistically
  FAILED
  SKIPPED
}

model Application {
  id              String            @id @default(uuid())
  userId          String
  jobId           String
  companyId       String
  /// Denormalized from JobPosting purely so the unique index below can exist.
  normalizedTitle String
  status          ApplicationStatus @default(QUEUED)

  resumeVariantId String?

  /// ONLY for an application with no ResumeVariant - a job reached through a
  /// manual-open link, where there is no generated variant to hold the text.
  ///
  /// A CHECK enforces that this and resumeVariantId are mutually exclusive. It
  /// used to be neither documented nor constrained, so the same cover letter could
  /// sit here AND on the variant with nothing saying which one was sent. Making
  /// them exclusive is what removes the ambiguity; a comment alone would not.
  coverLetter String? @db.Text

  screeningAnswers Json?

  /// Percentage of required fields the adapter managed to fill. This is the
  /// number that determines manual effort per application, so it is measured
  /// rather than assumed (PLAN.txt verification item 4).
  prefillCoverage Float?

  submittedAt      DateTime?
  confirmationText String?
  screenshotPath   String?
  failureReason    String?
  llmProvider      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           JobPosting     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company       Company        @relation(fields: [companyId], references: [id])
  resumeVariant ResumeVariant? @relation(fields: [resumeVariantId], references: [id])

  /// THE STRUCTURAL GUARD AGAINST RE-APPLYING.
  /// A duplicate application fails at the database, not in application logic
  /// that could carry a bug.
  ///
  /// SCOPED BY userId as of v2. Without userId this index is not merely
  /// incomplete, it is actively wrong: it would silently refuse one candidate's
  /// application because a DIFFERENT candidate had already applied to that role.
  /// See PLAN-v2 2A.3 - the one v1 invariant that roles break rather than
  /// extend.
  @@unique([userId, companyId, normalizedTitle])
  @@index([status])
  @@index([userId, status])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// THE HAND-KEPT TRACKER
// ---------------------------------------------------------------------------

/// Where an application you made yourself got to.
///
/// SEPARATE FROM ApplicationStatus, which describes the machine. QUEUED, PREPARED and
/// AWAITING_REVIEW are states of a form-filling job; none of them is something a person
/// ever learns about their own application. These are the answers an employer gives
/// back - including the commonest one, which is nothing at all.
enum TrackedStage {
  SAVED /// found it, not applied yet: the careers page is bookmarked and that is all
  APPLIED
  SCREENING /// recruiter call, take-home, anything before people who would be colleagues
  INTERVIEWING
  OFFER
  REJECTED
  GHOSTED /// no answer, and long enough that you have stopped expecting one
}

/// Somebody who might put a word in for you.
///
/// A TABLE RATHER THAN A NAME TYPED ON EACH APPLICATION. The same person refers you
/// three times, and their LinkedIn URL is something you look up once. Typed per row,
/// "Priya Nair", "priya" and "Priya (Zoho)" become three people who cannot be counted,
/// and the question this list exists to answer - who have I actually asked, and how
/// often - stops being answerable.
///
/// NO FOREIGN KEY TO Company, for the reason BlockedCompany has none: a contact's
/// employer is very often one no board here has been crawled for, so a picker would make
/// the contact unstatable until exactly too late.
///
/// NO UNIQUENESS ON THE NAME, deliberately. Two people really can be called Priya Nair,
/// and a list that refuses the second one is a list that cannot describe the referral
/// that actually happened. The picker shows "name — company" so the duplicate that IS a
/// mistake is visible, which is the safeguard this needs rather than a constraint.
model TrackedContact {
  id     String @id @default(uuid())
  userId String

  name String

  /// Where they work, as words. Shown beside the name in the referrer picker, because
  /// two contacts with one name are told apart by the company and by nothing else.
  company String?

  /// Their title, not yours.
  role String?

  linkedInUrl String?
  email       String?

  /// How you know them. The line that makes this list mean anything read six months
  /// later, when "Rahul S" on its own means nobody.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  referred TrackedApplication[]

  @@index([userId, name])
  @@map("tracked_contacts")
}

/// One application you made yourself, written down by hand.
///
/// WHY THIS IS NOT A ROW IN `applications`. Every row there has a jobId and a companyId -
/// a posting this system crawled and an employer it knows - and the unique index on
/// (userId, companyId, normalizedTitle) is the structural guard that stops the robot
/// applying twice. Neither survives contact with a hand-kept log. The job forwarded to
/// you on WhatsApp has no JobPosting row and may never get one, and applying twice - once
/// in March, again in November - is something people genuinely do and a tracker must be
/// able to record. Making `applications` accept nullable jobs would cost that duplicate
/// guard, which is the invariant in the pipeline most worth keeping.
///
/// So the two tables sit side by side and neither pretends to be the other: `applications`
/// is what the machine did, this is what you did.
model TrackedApplication {
  id     String @id @default(uuid())
  userId String

  /// Free text, and the only required field. Everything else about an application can
  /// genuinely be unknown at the moment you are typing it in. The employer's name cannot.
  company String

  /// The title as they advertised it.
  role String?

  /// The posting, and the employer's jobs page. BOTH, not one, because they rot at
  /// different speeds and for different reasons: the posting 404s the week the role is
  /// filled, while the careers page is still there a year later and is where you go to
  /// see whether it reopened. Keeping only the first loses the trail; keeping only the
  /// second loses what you actually applied to.
  jobUrl     String?
  careersUrl String?

  stage TrackedStage @default(APPLIED)

  /// The day you sent it. @db.Date rather than a timestamp: nobody remembers the hour,
  /// and storing midnight-in-some-timezone as though it were precise is how a date
  /// shifts by a day for a reader sitting in another one.
  appliedOn DateTime? @db.Date

  /// Whether you sent the recruiter or the hiring manager a LinkedIn request. A boolean
  /// and not a date, because the only thing anybody checks is "did I already" - and the
  /// follow-up question is answered by opening LinkedIn, never by this row.
  linkedInInviteSent Boolean @default(false)

  /// Whether a referral actually went in: somebody submitted your name, as opposed to you
  /// having asked and heard nothing back.
  referralGiven Boolean @default(false)

  /// Who did it.
  ///
  /// NULL with `referralGiven` true is legitimate - you know a referral happened and
  /// cannot remember through whom, and a tracker that refuses that forces a wrong answer
  /// instead of an incomplete one. The reverse is not legitimate, and a CHECK refuses it:
  /// a named referrer on a row that says no referral was given is a contradiction, not a
  /// partial record. See the migration.
  referrerId String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailSuggestions EmailSuggestion[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Restrict, NOT SetNull. Deleting a contact named on four applications would quietly
  /// turn four "referred by Priya" into four "referred by nobody", and afterwards there
  /// is nothing left to show that it happened. The service refuses the delete and names
  /// the applications instead.
  referrer TrackedContact? @relation(fields: [referrerId], references: [id], onDelete: Restrict)

  /// NO UNIQUE INDEX on (userId, company, role), unlike `applications` above. See the
  /// model note: reapplying is a real thing this log has to be able to hold.
  @@index([userId, stage])
  @@index([userId, appliedOn])
  @@index([referrerId])
  @@map("tracked_applications")
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS (phase 7)
// ---------------------------------------------------------------------------

/// One morning's summary, STORED rather than recomputed on every read.
///
/// Four reasons the numbers are written down instead of being a query:
///   1. The email and the web page have to agree. A digest that is recomputed
///      when the page loads disagrees with the mail sent two hours earlier, and
///      the disagreement looks like a bug in the pipeline rather than in the
///      page.
///   2. The window. Each digest covers "since the last one" - see
///      DigestService.windowStart - which needs the previous digest to exist as a
///      row. Without it a missed morning is silently skipped or double-counted.
///   3. The delivery record. Whether the mail left, whether Telegram took it, and
///      the error if neither - that is per-send state and has nowhere else to
///      live.
///   4. Restart safety. `@@unique([userId, day])` means a process that dies
///      mid-run and starts again rewrites one row instead of sending a second
///      copy of the same morning.
model DailyDigest {
  id     String @id @default(uuid())
  userId String

  /// The IST calendar day this digest is FOR, as a bare date. The candidate is in
  /// India, so "which morning is this" is a local-calendar question and storing an
  /// instant would put the 09:00 IST run on the previous UTC day. See
  /// DigestService.istDay.
  day DateTime @db.Date

  /// The whole rendered digest, validated on read by DigestPayloadSchema.
  /// Versioned (`version: 1`) so a payload written by older code is recognised
  /// and skipped rather than misread - see readPayload, which returns null
  /// instead of throwing.
  payload Json

  /// Delivery, one stamp per channel plus the last failure. Rewriting the payload
  /// deliberately does NOT clear these: a rebuild is not a resend.
  emailedAt     DateTime?
  telegramAt    DateTime?
  deliveryError String?

  /// Set when the candidate opens it in the web app. Drives the unread count in
  /// the nav.
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
  @@map("daily_digests")
}

/// One candidate's read-only Gmail grant, for the tracker's email sync.
///
/// Only the REFRESH token is kept, and only encrypted (AES-256-GCM under
/// TOKEN_ENCRYPTION_KEY - see secret-box.ts). Access tokens are minted per sync and
/// never stored. The scope is gmail.readonly: this grant cannot send, delete or label.
model GmailConnection {
  userId String @id

  /// The mailbox Google says was connected, shown so the candidate knows which one.
  email String

  /// `iv.tag.ciphertext`, base64url. Never logged, never returned by any route.
  refreshTokenEnc String

  /// When the last sync finished. The next one reads mail received after this, so
  /// each message is looked at once.
  lastSyncedAt DateTime?

  /// Why the last sync failed, in words for the screen. Cleared on the next success.
  lastError String?

  connectedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_connections")
}

enum EmailSuggestionStatus {
  PENDING
  APPLIED
  DISMISSED
}

/// Something an email says about an application, waiting for the candidate to accept.
///
/// A SUGGESTION AND NEVER A WRITE. The tracker's promise is that every row is something
/// the candidate put there; a model misreading "unfortunately the office is closed on
/// Friday" as a rejection must not be able to move a row on its own. So sync writes
/// here, and only the Apply button writes to tracked_applications.
///
/// No email body is stored - the subject, the sender and a short quote are what the
/// screen needs to let somebody judge the suggestion, and the rest is their mail.
model EmailSuggestion {
  id     String @id @default(uuid())
  userId String

  /// Gmail's message id. Unique per user so a re-sync never suggests the same thing twice.
  gmailMessageId String
  receivedAt     DateTime
  fromAddress    String
  subject        String

  company       String
  role          String?
  proposedStage TrackedStage

  /// The row this is about, or NULL for "this looks like a new application". SET NULL
  /// on delete, so removing the row leaves the suggestion readable as a new one.
  trackedApplicationId String?

  /// A sentence from the email that justifies the stage, capped at 300 characters.
  evidence String

  status    EmailSuggestionStatus @default(PENDING)
  createdAt DateTime              @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedApplication TrackedApplication? @relation(fields: [trackedApplicationId], references: [id], onDelete: SetNull)

  @@unique([userId, gmailMessageId])
  @@index([userId, status])
  @@map("email_suggestions")
}
