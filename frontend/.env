# Committed on purpose, and it holds NOTHING secret.
#
# NEXT_PUBLIC_* is inlined into the JavaScript bundle at build time, so anything
# put here is readable by anyone who loads the page. Treat this file as public.
# Real secrets live in the root .env, which the backend reads and which is
# gitignored - see README "Configuration".
#
# This was frontend/.env.local, which is machine-local and therefore absent from a
# fresh clone. The result was a web app whose only job is talking to the api,
# shipped without the api's address. A committed default fixes that; override it
# in .env.local (gitignored) if your api is somewhere else.
NEXT_PUBLIC_API_URL=http://localhost:3100
