{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "PORT",
    "NODE_ENV",
    "LLM_PROVIDER",
    "NEXT_PUBLIC_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },

    "prisma:generate": {
      "cache": false
    },

    "typecheck": {
      "dependsOn": ["prisma:generate"],
      "outputs": []
    },

    "lint": {
      "outputs": []
    },

    "lint:fix": {
      "cache": false
    },

    "test": {
      "dependsOn": ["prisma:generate"],
      "outputs": []
    },

    "test:cov": {
      "dependsOn": ["prisma:generate"],
      "outputs": ["coverage/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "dev:worker": {
      "cache": false,
      "persistent": true
    }
  }
}
